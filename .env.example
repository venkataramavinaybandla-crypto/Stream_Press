# STREAM PRESS — environment reference. Copy to .env for local use.
# On Render, set these in Dashboard → Environment (or as Secret Files).

# ── Auth-wall fix (cookie pipeline) ──────────────────────────────────────────
# Path to a Netscape-format cookies.txt exported from a logged-in browser.
# Locally: point at your export. On Render: upload it as a Secret File — it is
# mounted at /etc/secrets/cookies.txt and auto-detected even without this var.
YTMAX_COOKIES_FILE=

# Alternative to a file: paste the cookies.txt contents directly (multi-line).
YTMAX_COOKIES_TXT=

# ── Anti-bot / IP-block fix (separate failure mode from the auth wall) ───────
# Residential/rotating proxy, e.g. http://user:pass@host:port
YTMAX_PROXY=
# Randomized delay between fragment requests (seconds). Try 1 and 3 if a CDN
# starts throttling the server's IP.
YTMAX_SLEEP_INTERVAL=0
YTMAX_MAX_SLEEP_INTERVAL=0
YTMAX_SLEEP_INTERVAL_REQUESTS=0

# ── Extractor freshness ──────────────────────────────────────────────────────
# 1 = run `pip install -U yt-dlp` at startup (default in Dockerfile).
YTMAX_AUTOUPDATE_YTDLP=0

# ── Paths / tuning (optional) ────────────────────────────────────────────────
# Where finished files land. Use a persistent mount in production.
YTMAX_DOWNLOAD_DIR=
# Override the ffmpeg binary (defaults to system `ffmpeg`, then imageio-ffmpeg).
YTMAX_FFMPEG=
YTMAX_WORKERS=2
YTMAX_TASK_CAP=60
